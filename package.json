{
  "name": "dindim",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @dindim/shared --filter @dindim/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api": "pnpm --filter @dindim/api dev",
    "mobile": "pnpm --filter @dindim/mobile start",
    "postinstall": "node scripts/patch-native-cmake.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
