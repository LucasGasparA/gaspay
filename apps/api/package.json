{
  "name": "@financas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/migrate.js && node dist/index.js",
    "migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.27",
    "@financas/shared": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
