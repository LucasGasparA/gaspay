# Copie pra apps/api/.env e preencha. Validado por src/env.ts no boot — falta
# alguma dessas e o processo nem sobe.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# No docker-compose isso é sobrescrito pra apontar pro serviço `postgres` —
# só importa o valor daqui se você rodar a API fora do Docker. Porta 5433 (não
# 5432): evita colidir com um Postgres nativo que porventura já esteja
# ouvindo em 5432 no host.
DATABASE_URL=postgresql://financas:financas@localhost:5433/financas

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pela qual o navegador do celular (ou seu browser) enxerga a API. Em
# localhost funciona pro Google aceitar o redirect; um IP de LAN tipo
# 192.168.x.x geralmente NÃO é aceito como redirect URI do OAuth — pra testar
# o login pelo S23 físico vai precisar expor a API por HTTPS (Railway já
# resolve isso; local é só pra testar o resto).
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → OAuth client "Web application" (não Android, não
# precisa de SHA-1) → redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails autorizados a criar conta, separados por vírgula. Obrigatório e não
# pode ficar vazio — é o que impede qualquer um de se cadastrar.
ALLOWED_EMAILS=

MOBILE_SCHEME=dindim
RATE_LIMIT_PER_MINUTE=100
